{
  "name": "acme/symfony-app",
  "type": "project",
  "require": {
    "php": ">=8.2",
    "ext-ctype": "*",
    "symfony/framework-bundle": "7.1.*",
    "symfony/console": "7.1.*",
    "symfony/flex": "^2",
    "doctrine/orm": "^3.2",
    "twig/twig": "^3.8",
    "lexik/jwt-authentication-bundle": "^3.1",
    "monolog/monolog": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "symfony/phpunit-bridge": "7.1.*",
    "brianium/paratest": "^7.4",
    "behat/behat": "^3.14",
    "phpstan/phpstan": "^1.11"
  },
  "autoload": {
    "psr-4": { "App\\": "src/" },
    "classmap": ["../outside/"]
  },
  "autoload-dev": {
    "psr-4": { "App\\Tests\\": "tests/", "App\\Missing\\": "missing/" }
  },
  "config": {
    "platform": { "php": "8.2.0" },
    "github-oauth": { "github.com": "CANARY-composer-token" }
  },
  "repositories": [{ "type": "composer", "url": "https://CANARY-user:CANARY-pass@repo.example" }],
  "extra": {
    "symfony": { "require": "7.1.*", "allow-contrib": false }
  }
}
